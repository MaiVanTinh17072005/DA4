<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.ui.AddFriendDialog"
      styleClass="add-friend-dialog"
      stylesheets="@../css/add-friend-dialog.css"
      spacing="0"
      prefWidth="850"
      prefHeight="750">

    <!-- Header -->
    <HBox styleClass="dialog-header" alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Thêm Bạn Bè" styleClass="dialog-title"/>
            <Label text="Tìm kiếm và kết nối với bạn bè mới" styleClass="dialog-subtitle"/>
        </VBox>
        <Button fx:id="closeButton" 
                text="✕" 
                styleClass="close-button"
                onAction="#handleClose"/>
    </HBox>

    <!-- Search Section -->
    <VBox styleClass="search-section" spacing="12">
        <Label text="TÌM KIẾM NGƯỜI DÙNG" styleClass="section-label"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <TextField fx:id="searchField"
                       promptText="Nhập tên người dùng hoặc email..."
                       styleClass="search-input"
                       HBox.hgrow="ALWAYS"/>
            <Button fx:id="searchButton"
                    text="🔍 Tìm"
                    styleClass="search-button"
                    onAction="#handleSearch"/>
        </HBox>
        
        <!-- Search Results (Initially Hidden) -->
        <VBox fx:id="searchResultsContainer" 
              styleClass="search-results" 
              spacing="8"
              managed="false"
              visible="false">
            <Label text="KẾT QUẢ TÌM KIẾM" styleClass="results-label"/>
            <ScrollPane styleClass="search-results-scroll" 
                        fitToWidth="true" 
                        maxHeight="180"
                        minHeight="180">
                <VBox fx:id="searchResultsList" spacing="4"/>
            </ScrollPane>
        </VBox>
    </VBox>

    <!-- Suggestions Section -->
    <VBox styleClass="suggestions-section" VBox.vgrow="ALWAYS" spacing="12">
        <Label text="GỢI Ý KẾT BẠN" styleClass="section-label"/>
        <ScrollPane styleClass="suggestions-scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
            <VBox fx:id="suggestionsContainer" spacing="8" styleClass="suggestions-list"/>
        </ScrollPane>
    </VBox>

</VBox>
