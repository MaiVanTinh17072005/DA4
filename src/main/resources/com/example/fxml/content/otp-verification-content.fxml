<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.ui.OTPVerificationScene"
      alignment="CENTER" 
      spacing="25" 
      styleClass="login-card" 
      maxWidth="400" 
      maxHeight="550">

    <!-- Logo & Title -->
    <VBox alignment="CENTER" spacing="10">
        <Text text="Discord Mini" styleClass="app-title"/>
        <Text fx:id="titleText" text="Xác minh Email" styleClass="welcome-text"/>
        <Text fx:id="descriptionText" 
              text="Nhập mã 6 chữ số đã được gửi đến email của bạn"
              styleClass="secondary-text"
              wrappingWidth="350"
              textAlignment="CENTER"/>
    </VBox>

    <!-- Form Container -->
    <VBox spacing="20" styleClass="form-container">

        <!-- OTP Input Fields -->
        <VBox spacing="8" alignment="CENTER">
            <Label text="MÃ XÁC MINH" styleClass="form-label"/>
            <HBox fx:id="otpContainer" alignment="CENTER" spacing="10">
                <TextField fx:id="otpField1" 
                           styleClass="otp-input" 
                           maxWidth="50"
                           alignment="CENTER"/>
                <TextField fx:id="otpField2" 
                           styleClass="otp-input" 
                           maxWidth="50"
                           alignment="CENTER"/>
                <TextField fx:id="otpField3" 
                           styleClass="otp-input" 
                           maxWidth="50"
                           alignment="CENTER"/>
                <TextField fx:id="otpField4" 
                           styleClass="otp-input" 
                           maxWidth="50"
                           alignment="CENTER"/>
                <TextField fx:id="otpField5" 
                           styleClass="otp-input" 
                           maxWidth="50"
                           alignment="CENTER"/>
                <TextField fx:id="otpField6" 
                           styleClass="otp-input" 
                           maxWidth="50"
                           alignment="CENTER"/>
            </HBox>
            <Label fx:id="timerLabel" 
                   styleClass="secondary-text"
                   managed="false"
                   visible="false"/>
        </VBox>

        <!-- Error Message -->
        <Label fx:id="errorLabel"
               styleClass="error-text"
               wrapText="true"
               managed="false"
               visible="false"/>

        <!-- Verify Button -->
        <Button fx:id="verifyButton"
                text="Xác minh mã"
                styleClass="primary-button"
                onAction="#handleVerify"
                defaultButton="true"
                maxWidth="Infinity"/>

        <!-- Resend Code -->
        <HBox alignment="CENTER" spacing="5">
            <Text text="Không nhận được mã?"
                  styleClass="secondary-text"/>
            <Button fx:id="resendButton"
                    text="Gửi lại mã"
                    styleClass="link-text-bold"
                    onAction="#handleResend"/>
        </HBox>

        <!-- Back Link -->
        <HBox alignment="CENTER">
            <Hyperlink fx:id="backLink"
                       text="← Trở về Quên mật khẩu"
                       styleClass="link-text"
                       onAction="#handleBack"/>
        </HBox>
    </VBox>

    <!-- Loading Indicator (Hidden by default) -->
    <ProgressIndicator fx:id="loadingIndicator"
                       managed="false"
                       visible="false"
                       maxWidth="40"
                       maxHeight="40"/>
</VBox>

