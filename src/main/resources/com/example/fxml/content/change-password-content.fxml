<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.ui.ChangePasswordScene"
      alignment="CENTER" 
      spacing="25" 
      styleClass="login-card" 
      maxWidth="400" 
      maxHeight="550">

    <!-- Logo & Title -->
    <VBox alignment="CENTER" spacing="10">
        <Text text="Discord Mini" styleClass="app-title"/>
        <Text fx:id="titleText" text="Create New Password" styleClass="welcome-text"/>
        <Text fx:id="descriptionText" 
              text="Please enter your new password below"
              styleClass="secondary-text"
              wrappingWidth="350"
              textAlignment="CENTER"/>
    </VBox>

    <!-- Form Container -->
    <VBox spacing="20" styleClass="form-container">

        <!-- New Password Field with Visibility Toggle -->
        <VBox spacing="8">
            <Label text="NEW PASSWORD" styleClass="form-label"/>
            <HBox spacing="0" alignment="CENTER_LEFT">
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="newPasswordField"
                                   promptText="Enter your new password"
                                   styleClass="form-input"/>
                    <TextField fx:id="newPasswordTextField"
                               promptText="Enter your new password"
                               styleClass="form-input"
                               managed="false"
                               visible="false"/>
                </StackPane>
                <Button fx:id="newPasswordToggleButton"
                        text="👁"
                        styleClass="password-toggle-button"
                        onAction="#toggleNewPasswordVisibility"
                        minWidth="40"
                        minHeight="40"
                        maxWidth="40"
                        maxHeight="40"/>
            </HBox>
        </VBox>

        <!-- Confirm Password Field with Visibility Toggle -->
        <VBox spacing="8">
            <Label text="CONFIRM PASSWORD" styleClass="form-label"/>
            <HBox spacing="0" alignment="CENTER_LEFT">
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="confirmPasswordField"
                                   promptText="Confirm your new password"
                                   styleClass="form-input"/>
                    <TextField fx:id="confirmPasswordTextField"
                               promptText="Confirm your new password"
                               styleClass="form-input"
                               managed="false"
                               visible="false"/>
                </StackPane>
                <Button fx:id="confirmPasswordToggleButton"
                        text="👁"
                        styleClass="password-toggle-button"
                        onAction="#toggleConfirmPasswordVisibility"
                        minWidth="40"
                        minHeight="40"
                        maxWidth="40"
                        maxHeight="40"/>
            </HBox>
        </VBox>

        <!-- Error Message -->
        <Label fx:id="errorLabel"
               styleClass="error-text"
               wrapText="true"
               managed="false"
               visible="false"/>

        <!-- Submit Button -->
        <Button fx:id="submitButton"
                text="Change Password"
                styleClass="primary-button"
                onAction="#handleSubmit"
                defaultButton="true"
                maxWidth="Infinity"/>

        <!-- Back to Login -->
        <HBox alignment="CENTER" spacing="5">
            <Text text="Remember your password?"
                  styleClass="secondary-text"/>
            <Hyperlink fx:id="backToLoginLink"
                       text="Back to Login"
                       styleClass="link-text-bold"
                       onAction="#handleBackToLogin"/>
        </HBox>
    </VBox>

    <!-- Loading Indicator (Hidden by default) -->
    <ProgressIndicator fx:id="loadingIndicator"
                       managed="false"
                       visible="false"
                       maxWidth="40"
                       maxHeight="40"/>
</VBox>

