<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.ui.ForgotPasswordScene"
      alignment="CENTER" 
      spacing="25" 
      styleClass="login-card" 
      maxWidth="400" 
      maxHeight="500">

    <!-- Logo & Title -->
    <VBox alignment="CENTER" spacing="10">
        <Text text="Discord Mini" styleClass="app-title"/>
        <Text fx:id="titleText" text="Quên mật khẩu?" styleClass="welcome-text"/>
        <Text fx:id="descriptionText" 
              text="Nhập email của bạn và chúng tôi sẽ gửi cho bạn mã xác minh để đặt lại mật khẩu."
              styleClass="secondary-text"
              wrappingWidth="350"
              textAlignment="CENTER"/>
    </VBox>

    <!-- Form Container -->
    <VBox spacing="20" styleClass="form-container">

        <!-- Email Field -->
        <VBox spacing="8">
            <Label text="EMAIL" styleClass="form-label"/>
            <TextField fx:id="emailField"
                       promptText="Nhập địa chỉ email của bạn"
                       styleClass="form-input"/>
        </VBox>

        <!-- Error Message -->
        <Label fx:id="errorLabel"
               styleClass="error-text"
               wrapText="true"
               managed="false"
               visible="false"/>

        <!-- Submit Button -->
        <Button fx:id="submitButton"
                text="Gửi mã xác minh"
                styleClass="primary-button"
                onAction="#handleSubmit"
                defaultButton="true"
                maxWidth="Infinity"/>

        <!-- Back to Login -->
        <HBox alignment="CENTER" spacing="5">
            <Text text="Đã nhớ mật khẩu?"
                  styleClass="secondary-text"/>
            <Hyperlink fx:id="backToLoginLink"
                       text="Trở về đăng nhập"
                       styleClass="link-text-bold"
                       onAction="#handleBackToLogin"/>
        </HBox>
    </VBox>

    <!-- Loading Indicator (Hidden by default) -->
    <ProgressIndicator fx:id="loadingIndicator"
                       managed="false"
                       visible="false"
                       maxWidth="40"
                       maxHeight="40"/>
</VBox>

