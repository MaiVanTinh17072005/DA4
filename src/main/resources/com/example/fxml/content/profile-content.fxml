<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.ui.ProfileScene"
            fitToWidth="true"
            styleClass="profile-scroll"
            stylesheets="@../../css/profile.css">

    <VBox alignment="TOP_CENTER" spacing="0" styleClass="profile-container">



        <!-- Main Content -->
        <VBox alignment="TOP_CENTER" spacing="30" styleClass="profile-content">
            <padding><Insets top="60" right="40" bottom="0" left="40"/></padding>

            <!-- Avatar Card -->
            <VBox alignment="CENTER" spacing="15" styleClass="avatar-section">
                <StackPane>
                    <Circle fx:id="avatarCircle" radius="65" styleClass="avatar"/>
                    <Button text="📷"
                            styleClass="avatar-btn"
                            onAction="#handleChangeAvatar"
                            StackPane.alignment="BOTTOM_RIGHT"
                            translateX="-5"
                            translateY="-5"/>
                </StackPane>
                <Label fx:id="usernameLabel" text="Minh Anh" styleClass="username"/>
                <Label fx:id="statusLabel" text="● Online" styleClass="status"/>
            </VBox>

            <!-- Notification Bar -->
            <HBox fx:id="notificationBar" 
                  styleClass="notification-bar" 
                  alignment="CENTER_LEFT" 
                  spacing="10"
                  maxWidth="500"
                  managed="false"
                  visible="false">
                <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                <Label fx:id="notificationIcon" styleClass="notification-icon"/>
                <Label fx:id="notificationMessage" 
                       styleClass="notification-message" 
                       wrapText="true"
                       HBox.hgrow="ALWAYS"/>
                <Button fx:id="notificationCloseBtn" 
                        text="✕" 
                        styleClass="notification-close"
                        onAction="#handleCloseNotification"/>
            </HBox>

            <!-- Info Form -->
            <VBox spacing="20" styleClass="info-form" maxWidth="500">

                <!-- Email -->
                <VBox spacing="8">
                    <Label text="EMAIL" styleClass="field-label"/>
                    <HBox spacing="10" styleClass="field-row">
                        <TextField fx:id="emailField"
                                   text="minhanh@gmail.com"
                                   editable="false"
                                   styleClass="field-input"
                                   HBox.hgrow="ALWAYS"/>
                        <Button text="✏️"
                                styleClass="edit-btn"
                                onAction="#handleEditEmail"/>
                    </HBox>
                </VBox>

                <!-- Username -->
                <VBox spacing="8">
                    <Label text="USERNAME" styleClass="field-label"/>
                    <HBox spacing="10" styleClass="field-row">
                        <TextField fx:id="usernameField"
                                   text="Minh Anh"
                                   editable="false"
                                   styleClass="field-input"
                                   HBox.hgrow="ALWAYS"/>
                        <Button text="✏️"
                                styleClass="edit-btn"
                                onAction="#handleEditUsername"/>
                    </HBox>
                </VBox>

                <!-- Change Password -->
                <VBox spacing="8">
                    <Label text="PASSWORD" styleClass="field-label"/>
                    <Button text="Change Password"
                            styleClass="action-btn"
                            onAction="#handleChangePassword"
                            maxWidth="Infinity"/>
                </VBox>


            </VBox>
        </VBox>
    </VBox>
</ScrollPane>