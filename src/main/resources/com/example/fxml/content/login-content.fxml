<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.ui.LoginScene"
      alignment="CENTER" 
      spacing="25" 
      styleClass="login-card" 
      maxWidth="400" 
      maxHeight="500">

    <!-- Logo & Title -->
    <VBox alignment="CENTER" spacing="10">
        <Text text="Discord Mini" styleClass="app-title"/>
        <Text fx:id="welcomeText" text="Welcome back!" styleClass="welcome-text"/>
    </VBox>

    <!-- Form Container -->
    <VBox spacing="20" styleClass="form-container">

        <!-- Email Field -->
        <VBox spacing="8">
            <Label text="EMAIL OR USERNAME" styleClass="form-label"/>
            <TextField fx:id="emailField"
                       promptText="Enter your email or username"
                       styleClass="form-input"/>
        </VBox>

        <!-- Password Field -->
        <VBox spacing="8">
            <Label text="PASSWORD" styleClass="form-label"/>
            <PasswordField fx:id="passwordField"
                           promptText="Enter your password"
                           styleClass="form-input"/>
        </VBox>

        <!-- Forgot Password (Only for Login) -->
        <HBox fx:id="forgotPasswordBox">
            <Hyperlink fx:id="forgotPasswordLink"
                       text="Forgot your password?"
                       styleClass="link-text"
                       onAction="#handleForgotPassword"/>
        </HBox>

        <!-- Confirm Password (Only for Register) -->
        <VBox fx:id="confirmPasswordBox" spacing="8" managed="false" visible="false">
            <Label text="CONFIRM PASSWORD" styleClass="form-label"/>
            <PasswordField fx:id="confirmPasswordField"
                           promptText="Confirm your password"
                           styleClass="form-input"/>
        </VBox>

        <!-- Error Message -->
        <Label fx:id="errorLabel"
               styleClass="error-text"
               wrapText="true"
               managed="false"
               visible="false"/>

        <!-- Login/Register Button -->
        <Button fx:id="actionButton"
                text="Log In"
                styleClass="primary-button"
                onAction="#handleAction"
                defaultButton="true"
                maxWidth="Infinity"/>

        <!-- Toggle Login/Register -->
        <HBox alignment="CENTER" spacing="5">
            <Text fx:id="togglePromptText"
                  text="Need an account?"
                  styleClass="secondary-text"/>
            <Hyperlink fx:id="toggleLink"
                       text="Register"
                       styleClass="link-text-bold"
                       onAction="#handleToggleMode"/>
        </HBox>
    </VBox>

    <!-- Loading Indicator (Hidden by default) -->
    <ProgressIndicator fx:id="loadingIndicator"
                       managed="false"
                       visible="false"
                       maxWidth="40"
                       maxHeight="40"/>
</VBox>

