<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.ui.LoginScene"
      alignment="CENTER" 
      spacing="25" 
      styleClass="login-card" 
      maxWidth="400" 
      maxHeight="500">

    <!-- Logo & Title -->
    <VBox alignment="CENTER" spacing="10">
        <Text text="Discord Mini" styleClass="app-title"/>
        <Text fx:id="welcomeText" text="Chào mừng trở lại!" styleClass="welcome-text"/>
    </VBox>

    <!-- Form Container -->
    <VBox spacing="20" styleClass="form-container">

        <!-- Email Field (Login: Email only, Register: Email only) -->
        <VBox spacing="8">
            <Label fx:id="emailLabel" text="EMAIL" styleClass="form-label"/>
            <TextField fx:id="emailField"
                       promptText="Nhập địa chỉ email của bạn"
                       styleClass="form-input"/>
        </VBox>

        <!-- Username Field (Only for Register) -->
        <VBox fx:id="usernameBox" spacing="8" managed="false" visible="false">
            <Label text="TÊN NGƯỜI DÙNG" styleClass="form-label"/>
            <TextField fx:id="usernameField"
                       promptText="Nhập tên người dùng"
                       styleClass="form-input"/>
        </VBox>

        <!-- Password Field with Visibility Toggle -->
        <VBox spacing="8">
            <Label text="MẬT KHẨU" styleClass="form-label"/>
            <HBox spacing="0" alignment="CENTER_LEFT">
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="passwordField"
                                   promptText="Nhập mật khẩu"
                                   styleClass="form-input"/>
                    <TextField fx:id="passwordTextField"
                               promptText="Nhập mật khẩu"
                               styleClass="form-input"
                               managed="false"
                               visible="false"/>
                </StackPane>
                <Button fx:id="passwordToggleButton"
                        text="👁"
                        styleClass="password-toggle-button"
                        onAction="#togglePasswordVisibility"
                        minWidth="40"
                        minHeight="40"
                        maxWidth="40"
                        maxHeight="40"/>
            </HBox>
        </VBox>

        <!-- Forgot Password (Only for Login) -->
        <HBox fx:id="forgotPasswordBox">
            <Hyperlink fx:id="forgotPasswordLink"
                       text="Quên mật khẩu?"
                       styleClass="link-text"
                       onAction="#handleForgotPassword"/>
        </HBox>

        <!-- Confirm Password (Only for Register) with Visibility Toggle -->
        <VBox fx:id="confirmPasswordBox" spacing="8" managed="false" visible="false">
            <Label text="XÁC NHẬN MẬT KHẨU" styleClass="form-label"/>
            <HBox spacing="0" alignment="CENTER_LEFT">
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="confirmPasswordField"
                                   promptText="Xác nhận mật khẩu"
                                   styleClass="form-input"/>
                    <TextField fx:id="confirmPasswordTextField"
                               promptText="Xác nhận mật khẩu"
                               styleClass="form-input"
                               managed="false"
                               visible="false"/>
                </StackPane>
                <Button fx:id="confirmPasswordToggleButton"
                        text="👁"
                        styleClass="password-toggle-button"
                        onAction="#toggleConfirmPasswordVisibility"
                        minWidth="40"
                        minHeight="40"
                        maxWidth="40"
                        maxHeight="40"/>
            </HBox>
        </VBox>

        <!-- Error Message -->
        <Label fx:id="errorLabel"
               styleClass="error-text"
               wrapText="true"
               managed="false"
               visible="false"/>

        <!-- Login/Register Button -->
        <Button fx:id="actionButton"
                text="Đăng nhập"
                styleClass="primary-button"
                onAction="#handleAction"
                defaultButton="true"
                maxWidth="Infinity"/>

        <!-- Toggle Login/Register -->
        <HBox alignment="CENTER" spacing="5">
            <Text fx:id="togglePromptText"
                  text="Chưa có tài khoản?"
                  styleClass="secondary-text"/>
            <Hyperlink fx:id="toggleLink"
                       text="Đăng ký"
                       styleClass="link-text-bold"
                       onAction="#handleToggleMode"/>
        </HBox>
    </VBox>

    <!-- Loading Indicator (Hidden by default) -->
    <ProgressIndicator fx:id="loadingIndicator"
                       managed="false"
                       visible="false"
                       maxWidth="40"
                       maxHeight="40"/>
</VBox>

