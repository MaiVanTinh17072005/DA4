<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.ui.OTPVerificationScene"
           styleClass="root">

    <!-- Background -->
    <VBox alignment="CENTER" spacing="0" styleClass="login-background">

        <!-- OTP Verification Card -->
        <VBox alignment="CENTER" spacing="25" styleClass="login-card" maxWidth="400" maxHeight="550">

            <!-- Logo & Title -->
            <VBox alignment="CENTER" spacing="10">
                <Text text="Discord Mini" styleClass="app-title"/>
                <Text fx:id="titleText" text="Verify Your Email" styleClass="welcome-text"/>
                <Text fx:id="descriptionText" 
                      text="Enter the 6-digit code sent to your email"
                      styleClass="secondary-text"
                      wrappingWidth="350"
                      textAlignment="CENTER"/>
            </VBox>

            <!-- Form Container -->
            <VBox spacing="20" styleClass="form-container">

                <!-- OTP Input Fields -->
                <VBox spacing="8" alignment="CENTER">
                    <Label text="VERIFICATION CODE" styleClass="form-label"/>
                    <HBox fx:id="otpContainer" alignment="CENTER" spacing="10">
                        <TextField fx:id="otpField1" 
                                   styleClass="otp-input" 
                                   maxWidth="50"
                                   alignment="CENTER"/>
                        <TextField fx:id="otpField2" 
                                   styleClass="otp-input" 
                                   maxWidth="50"
                                   alignment="CENTER"/>
                        <TextField fx:id="otpField3" 
                                   styleClass="otp-input" 
                                   maxWidth="50"
                                   alignment="CENTER"/>
                        <TextField fx:id="otpField4" 
                                   styleClass="otp-input" 
                                   maxWidth="50"
                                   alignment="CENTER"/>
                        <TextField fx:id="otpField5" 
                                   styleClass="otp-input" 
                                   maxWidth="50"
                                   alignment="CENTER"/>
                        <TextField fx:id="otpField6" 
                                   styleClass="otp-input" 
                                   maxWidth="50"
                                   alignment="CENTER"/>
                    </HBox>
                    <Label fx:id="timerLabel" 
                           styleClass="secondary-text"
                           managed="false"
                           visible="false"/>
                </VBox>

                <!-- Error Message -->
                <Label fx:id="errorLabel"
                       styleClass="error-text"
                       wrapText="true"
                       managed="false"
                       visible="false"/>

                <!-- Verify Button -->
                <Button fx:id="verifyButton"
                        text="Verify Code"
                        styleClass="primary-button"
                        onAction="#handleVerify"
                        defaultButton="true"
                        maxWidth="Infinity"/>

                <!-- Resend Code -->
                <HBox alignment="CENTER" spacing="5">
                    <Text text="Didn't receive the code?"
                          styleClass="secondary-text"/>
                    <Button fx:id="resendButton"
                            text="Resend Code"
                            styleClass="link-text-bold"
                            onAction="#handleResend"/>
                </HBox>

                <!-- Back Link -->
                <HBox alignment="CENTER">
                    <Hyperlink fx:id="backLink"
                               text="← Back to Forgot Password"
                               styleClass="link-text"
                               onAction="#handleBack"/>
                </HBox>
            </VBox>

            <!-- Loading Indicator (Hidden by default) -->
            <ProgressIndicator fx:id="loadingIndicator"
                               managed="false"
                               visible="false"
                               maxWidth="40"
                               maxHeight="40"/>
        </VBox>

        <!-- Footer -->
        <HBox alignment="CENTER" spacing="5" styleClass="footer">
            <Text text="Discord Mini v1.0" styleClass="footer-text"/>
            <Text text="•" styleClass="footer-text"/>
            <Hyperlink text="About" styleClass="footer-link"/>
            <Text text="•" styleClass="footer-text"/>
            <Hyperlink text="Help" styleClass="footer-link"/>
        </HBox>
    </VBox>
</StackPane>

