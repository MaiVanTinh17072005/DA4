<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.ui.MainLayoutController"
           styleClass="root"
           minWidth="-Infinity"
           minHeight="-Infinity"
           maxWidth="Infinity"
           maxHeight="Infinity">

    <!-- Background Container (Shared) -->
    <VBox alignment="CENTER" spacing="0" styleClass="login-background"
          minWidth="-Infinity"
          minHeight="-Infinity"
          maxWidth="Infinity"
          maxHeight="Infinity">

        <!-- Content Container (Will be swapped) -->
        <StackPane fx:id="contentContainer" 
                   alignment="CENTER"
                   minWidth="-Infinity"
                   minHeight="-Infinity"
                   maxWidth="Infinity"
                   maxHeight="Infinity">
            <!-- Content will be dynamically loaded here -->
        </StackPane>

        <!-- Footer (Shared) -->
        <HBox alignment="CENTER" spacing="5" styleClass="footer">
            <Text text="Discord Mini v1.0" styleClass="footer-text"/>
            <Text text="•" styleClass="footer-text"/>
            <Hyperlink text="About" styleClass="footer-link"/>
            <Text text="•" styleClass="footer-text"/>
            <Hyperlink text="Help" styleClass="footer-link"/>
        </HBox>
    </VBox>
</StackPane>

