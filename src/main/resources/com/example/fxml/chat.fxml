<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.ui.ChatScene"
            minWidth="1200"
            minHeight="700"
            maxWidth="Infinity"
            maxHeight="Infinity"
            stylesheets="@../css/chat.css"
            styleClass="root">

    <!-- Main Content -->
    <center>
        <HBox spacing="0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
              AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" 
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
            
            <!-- ========== LEFT SIDEBAR: Servers/Channels ========== -->
            <VBox styleClass="server-sidebar" prefWidth="72">
                <!-- Home Button -->
                <VBox alignment="CENTER" styleClass="server-icon-container">
                    <Button styleClass="server-icon, home-icon" text="🏠" onAction="#handleHomeClick">
                        <tooltip><Tooltip text="Home"/></tooltip>
                    </Button>
                </VBox>
                
                <Separator styleClass="server-separator"/>
                
                <!-- Server Icons -->
                <VBox alignment="CENTER" styleClass="server-icon-container">
                    <Button styleClass="server-icon" text="D" onAction="#handleServerClick">
                        <tooltip><Tooltip text="Discord Mini"/></tooltip>
                    </Button>
                </VBox>
                
                <VBox alignment="CENTER" styleClass="server-icon-container">
                    <Button styleClass="server-icon" text="F" onAction="#handleServerClick">
                        <tooltip><Tooltip text="Friends"/></tooltip>
                    </Button>
                </VBox>
                
                <VBox alignment="CENTER" styleClass="server-icon-container">
                    <Button styleClass="server-icon" text="G" onAction="#handleServerClick">
                        <tooltip><Tooltip text="Groups"/></tooltip>
                    </Button>
                </VBox>
                
                <Region VBox.vgrow="ALWAYS"/>
                
                <!-- Add Server Button -->
                <VBox alignment="CENTER" styleClass="server-icon-container">
                    <Button styleClass="server-icon, add-server-icon" text="+" onAction="#handleAddServer">
                        <tooltip><Tooltip text="Add a Server"/></tooltip>
                    </Button>
                </VBox>
            </VBox>

            <!-- ========== MIDDLE PANEL: Conversations List ========== -->
            <VBox styleClass="conversation-sidebar" prefWidth="320">
                <!-- Search Bar -->
                <HBox styleClass="search-container" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField"
                               promptText="🔍 Tìm kiếm hoặc bắt đầu cuộc trò chuyện..."
                               styleClass="search-field"
                               HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Filter Tabs -->
                <HBox styleClass="filter-tabs" spacing="8">
                    <ToggleButton fx:id="filterDMButton" 
                                  text="Bạn bè" 
                                  selected="true" 
                                  onAction="#handleFilterDM"
                                  styleClass="filter-tab"/>
                    <ToggleButton fx:id="filterGroupButton" 
                                  text="Nhóm" 
                                  onAction="#handleFilterGroup"
                                  styleClass="filter-tab"/>
                    <ToggleButton fx:id="filterFavoriteButton" 
                                  text="⭐ Yêu thích" 
                                  onAction="#handleFilterFavorite"
                                  styleClass="filter-tab"/>
                </HBox>

                <!-- Conversations List -->
                <ScrollPane styleClass="conversation-scroll" VBox.vgrow="ALWAYS" fitToWidth="true">
                    <ListView fx:id="conversationListView" styleClass="conversation-list"/>
                </ScrollPane>

                <!-- User Profile at Bottom -->
                <HBox styleClass="user-profile-bar" alignment="CENTER_LEFT" spacing="10">
                    <Circle radius="20" styleClass="user-avatar"/>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="currentUserNameLabel" text="Minh Anh" styleClass="user-name"/>
                        <Label fx:id="currentUserStatusLabel" text="🟢 Online" styleClass="user-status"/>
                    </VBox>
                    <Button styleClass="icon-btn" text="⚙️" onAction="#handleSettings">
                        <tooltip><Tooltip text="Cài đặt"/></tooltip>
                    </Button>
                </HBox>
            </VBox>

            <!-- ========== RIGHT PANEL: Chat Area ========== -->
            <VBox styleClass="chat-area" HBox.hgrow="ALWAYS">
                
                <!-- Chat Header -->
                <HBox styleClass="chat-header" alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="activeConversationLabel" 
                               text="# Chọn một cuộc trò chuyện" 
                               styleClass="chat-header-title"/>
                        <Label fx:id="activeStatusLabel" 
                               text="Chọn bạn bè hoặc nhóm để bắt đầu chat" 
                               styleClass="chat-header-subtitle"/>
                    </VBox>
                    
                    <!-- Action Buttons -->
                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Button styleClass="header-icon-btn" text="📞" onAction="#handleStartVoiceCall">
                            <tooltip><Tooltip text="Gọi thoại"/></tooltip>
                        </Button>
                        <Button styleClass="header-icon-btn" text="📹" onAction="#handleStartVideoCall">
                            <tooltip><Tooltip text="Gọi video"/></tooltip>
                        </Button>
                        <Button styleClass="header-icon-btn" text="📌" onAction="#handlePinChat">
                            <tooltip><Tooltip text="Ghim chat"/></tooltip>
                        </Button>
                        <Button styleClass="header-icon-btn" text="👥" onAction="#handleShowMembers">
                            <tooltip><Tooltip text="Thành viên"/></tooltip>
                        </Button>
                        <Button styleClass="header-icon-btn" text="🔍" onAction="#handleSearchInChat">
                            <tooltip><Tooltip text="Tìm kiếm"/></tooltip>
                        </Button>
                    </HBox>
                </HBox>

                <!-- Messages Area -->
                <ScrollPane styleClass="messages-scroll" VBox.vgrow="ALWAYS" fitToWidth="true">
                    <VBox styleClass="messages-container">
                        <ListView fx:id="messageListView" styleClass="message-list"/>
                    </VBox>
                </ScrollPane>

                <!-- Message Input Area -->
                <VBox styleClass="message-input-container">
                    <!-- Typing Indicator -->
                    <Label fx:id="typingStatusLabel" 
                           text="" 
                           styleClass="typing-indicator"
                           managed="false"
                           visible="false"/>
                    
                    <!-- Input Box -->
                    <HBox styleClass="message-input-box" alignment="CENTER" spacing="8">
                        <!-- Attachment Button -->
                        <Button styleClass="input-icon-btn" text="➕" onAction="#handleAttachment">
                            <tooltip><Tooltip text="Đính kèm file"/></tooltip>
                        </Button>
                        
                        <!-- Text Input -->
                        <TextArea fx:id="messageInput"
                                  promptText="Nhắn tin tới..."
                                  wrapText="true"
                                  prefRowCount="1"
                                  styleClass="message-textarea"
                                  HBox.hgrow="ALWAYS"/>
                        
                        <!-- Emoji Button -->
                        <Button styleClass="input-icon-btn" text="😀" onAction="#handleInsertEmoji">
                            <tooltip><Tooltip text="Emoji"/></tooltip>
                        </Button>
                        
                        <!-- Send Button -->
                        <Button fx:id="sendButton" 
                                styleClass="send-button" 
                                text="Gửi" 
                                onAction="#handleSendMessage">
                            <tooltip><Tooltip text="Gửi tin nhắn (Enter)"/></tooltip>
                        </Button>
                    </HBox>
                    
                    <!-- Connection Status -->
                    <HBox styleClass="connection-status-bar" alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="connectionStatusLabel" 
                               text="🟢 Đã kết nối với máy chủ" 
                               styleClass="status-text"/>
                        <Label text="•" styleClass="status-separator"/>
                        <Label fx:id="encryptionStatusLabel" 
                               text="🔒 E2EE đang hoạt động" 
                               styleClass="status-text"/>
                        <Label text="•" styleClass="status-separator"/>
                        <Label fx:id="lanModeLabel" 
                               text="🌐 Hybrid P2P Mode" 
                               styleClass="status-text"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- ========== FAR RIGHT PANEL: Member List / Info (Optional) ========== -->
            <VBox styleClass="info-sidebar" prefWidth="240" managed="false" visible="false">
                <Label text="Thành viên" styleClass="info-sidebar-title"/>
                
                <VBox spacing="12" styleClass="members-section">
                    <Label text="ONLINE — 3" styleClass="member-category"/>
                    <ListView fx:id="onlineListView" styleClass="member-list" prefHeight="200"/>
                    
                    <Label text="OFFLINE — 2" styleClass="member-category"/>
                    <ListView fx:id="offlineListView" styleClass="member-list" prefHeight="150"/>
                </VBox>
                
                <Separator styleClass="info-separator"/>
                
                <VBox spacing="12" styleClass="groups-section">
                    <Label text="NHÓM CỦA BẠN" styleClass="member-category"/>
                    <ListView fx:id="groupOverviewListView" styleClass="member-list"/>
                </VBox>
            </VBox>
            
        </HBox>
    </center>

</BorderPane>
