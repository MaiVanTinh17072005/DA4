<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.ui.ForgotPasswordScene"
           styleClass="root"
           minWidth="-Infinity"
           minHeight="-Infinity"
           maxWidth="Infinity"
           maxHeight="Infinity">

    <!-- Background -->
    <VBox alignment="CENTER" spacing="0" styleClass="login-background"
          minWidth="-Infinity"
          minHeight="-Infinity"
          maxWidth="Infinity"
          maxHeight="Infinity">

        <!-- Forgot Password Card -->
        <VBox alignment="CENTER" spacing="25" styleClass="login-card" maxWidth="400" maxHeight="500">

            <!-- Logo & Title -->
            <VBox alignment="CENTER" spacing="10">
                <Text text="Discord Mini" styleClass="app-title"/>
                <Text fx:id="titleText" text="Forgot Password?" styleClass="welcome-text"/>
                <Text fx:id="descriptionText" 
                      text="Enter your email and we'll send you a verification code to reset your password."
                      styleClass="secondary-text"
                      wrappingWidth="350"
                      textAlignment="CENTER"/>
            </VBox>

            <!-- Form Container -->
            <VBox spacing="20" styleClass="form-container">

                <!-- Email Field -->
                <VBox spacing="8">
                    <Label text="EMAIL" styleClass="form-label"/>
                    <TextField fx:id="emailField"
                               promptText="Enter your email address"
                               styleClass="form-input"/>
                </VBox>

                <!-- Error Message -->
                <Label fx:id="errorLabel"
                       styleClass="error-text"
                       wrapText="true"
                       managed="false"
                       visible="false"/>

                <!-- Submit Button -->
                <Button fx:id="submitButton"
                        text="Send Verification Code"
                        styleClass="primary-button"
                        onAction="#handleSubmit"
                        defaultButton="true"
                        maxWidth="Infinity"/>

                <!-- Back to Login -->
                <HBox alignment="CENTER" spacing="5">
                    <Text text="Remember your password?"
                          styleClass="secondary-text"/>
                    <Hyperlink fx:id="backToLoginLink"
                               text="Back to Login"
                               styleClass="link-text-bold"
                               onAction="#handleBackToLogin"/>
                </HBox>
            </VBox>

            <!-- Loading Indicator (Hidden by default) -->
            <ProgressIndicator fx:id="loadingIndicator"
                               managed="false"
                               visible="false"
                               maxWidth="40"
                               maxHeight="40"/>
        </VBox>

        <!-- Footer -->
        <HBox alignment="CENTER" spacing="5" styleClass="footer">
            <Text text="Discord Mini v1.0" styleClass="footer-text"/>
            <Text text="•" styleClass="footer-text"/>
            <Hyperlink text="About" styleClass="footer-link"/>
            <Text text="•" styleClass="footer-text"/>
            <Hyperlink text="Help" styleClass="footer-link"/>
        </HBox>
    </VBox>
</StackPane>

